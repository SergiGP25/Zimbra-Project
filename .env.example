PROJECT_NAME="Zimbra CRM - Sistemas Transaccionales"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# IMPORTANTE: cambiar en cualquier entorno real
SECRET_KEY="change-this-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

DB_HOST="db"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="crm_zimbra"
DATABASE_URL=""

HOST="0.0.0.0"
PORT=8000

# Dirección del frontend (se usa en los enlaces de los correos)
FRONTEND_URL="http://localhost:5174"

# Correos: consola | smtp | brevo  (ver backend/app/core/correo.py)
# En Docker se usa smtp con Mailpit (http://localhost:8025) sin configurar nada.
# Para correos reales en Railway: CORREO_MODO="brevo" y BREVO_API_KEY.
CORREO_REMITENTE="no-reply@zimbra-demo.com"
CORREO_REMITENTE_NOMBRE="Zimbra CRM"
SMTP_USUARIO=""
SMTP_CLAVE=""
SMTP_TLS=false
BREVO_API_KEY=""
RESET_TOKEN_MINUTOS=30
